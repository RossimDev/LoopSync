# ─────────────────────────────────────────────────────────────
# LoopSync — variáveis de ambiente
# Copie para `.env` (ou exporte no shell / no painel do seu host)
# NUNCA faça commit de `.env` com valores reais.
# Guia completo: docs/YOUTUBE_SETUP.md
# ─────────────────────────────────────────────────────────────

# ── Servidor do LoopSync ─────────────────────────────────────
# Porta HTTP (0 = porta aleatória livre; usada nos testes).
PORT=3000
# Interface de rede. Mantenha 0.0.0.0 para acessar de outros dispositivos.
HOST=0.0.0.0
# development | production | test
NODE_ENV=production

# Pasta do banco local (JSON) com conexões, descrições, tags e histórico.
# Padrão: ./data  →  data/loopsync-store.json
LOOPSYNC_DATA_DIR=./data

# Limite de tamanho aceito no upload de mídia do LoopSync (bytes). Padrão: 2 GB.
LOOPSYNC_MAX_UPLOAD_BYTES=2147483648

# Por quanto tempo o resultado processado fica disponível no servidor (ms).
LOOPSYNC_RESULT_RETENTION_MS=600000

# Cookie de sessão marcado como Secure (exige HTTPS). Use 1 em produção.
LOOPSYNC_COOKIE_SECURE=0

# ── Google / YouTube (obrigatórias para o módulo YouTube) ────
# Google Cloud Console → APIs e serviços → Credenciais → OAuth 2.0 (Web)
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# URI de redirecionamento autorizado (deve bater EXATAMENTE com o cadastrado
# no Google Cloud). Em desenvolvimento local pode ser omitido: o LoopSync
# deriva da origem da requisição (ex.: http://localhost:3000/api/youtube/auth/callback).
GOOGLE_REDIRECT_URI=https://seu-dominio.com/api/youtube/auth/callback

# ── Opcionais: endpoints do Google (úteis para testes/proxy) ─
GOOGLE_AUTH_BASE=https://accounts.google.com
# Base PÚBLICA usada só na URL de autorização aberta no navegador.
# Use apenas quando o servidor alcança o Google por um endereço interno
# (proxy/rede privada/demo) e o navegador precisa de outra URL.
# GOOGLE_PUBLIC_AUTH_BASE=https://accounts.google.com
GOOGLE_API_BASE=https://www.googleapis.com
YOUTUBE_API_BASE=https://www.googleapis.com/youtube/v3
YOUTUBE_UPLOAD_BASE=https://www.googleapis.com/upload/youtube/v3

# ── Opcionais: tempos e limites do envio ─────────────────────
# Timeout de chamadas comuns à API do Google (ms).
GOOGLE_TIMEOUT_MS=30000
# Timeout por bloco de upload (ms).
GOOGLE_CHUNK_TIMEOUT_MS=120000
# Maior bloco aceito pelo servidor (bytes). O navegador usa blocos menores
# (2/5/8 MB conforme o tamanho do arquivo), sempre múltiplos de 256 KB.
LOOPSYNC_YT_MAX_CHUNK_BYTES=16777216
# Intervalo mínimo entre consultas de processamento do vídeo no YouTube (ms).
LOOPSYNC_YT_STATUS_POLL_MS=8000

# ── Somente para os testes automatizados (não usar em produção) ─
# Porta do mock dos endpoints do Google.
# MOCK_PORT=0
# Pasta onde o teste de navegador salva capturas de tela.
# SCREENSHOTS=./tmp-test-assets/screenshots
